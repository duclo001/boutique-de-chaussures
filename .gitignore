# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# documentation markdown files (notes locales)
*.md

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# service worker généré par Serwist (ne pas versionner)
/public/sw.js
/public/sw.js.map
/public/swe-worker-*.js

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# On versionne .env : il ne contient que des cles EmailJS NEXT_PUBLIC (non sensibles,
# deja exposees cote client) pour que toute l'equipe ait une app fonctionnelle apres un pull.
# .env.local reste ignore pour d'eventuels reglages locaux.
!.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Rapport récapitulatif (non suivi)
docs/recapitulatif-semaine2.md
CLAUDE.md
