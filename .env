# ──────────────────────────────────────────────────────────────
# Identifiants EmailJS (https://dashboard.emailjs.com/)
# Ces valeurs sont lues cote client → elles commencent par NEXT_PUBLIC_.
#
# Elles ne sont PAS sensibles : la cle publique EmailJS est concue pour etre
# exposee dans le navigateur (elle est de toute facon incluse dans le bundle JS).
# On les versionne donc pour que toute l'equipe ait une app fonctionnelle.
#
# ⚠️ Apres un git pull, pense a REDEMARRER le serveur (npm run dev) pour que
#    Next.js recharge ces variables.
# ──────────────────────────────────────────────────────────────

# Le service Gmail connecte dans EmailJS (onglet "Email Services")
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_7fdt8yp

# Template qui envoie le message A LA BOUTIQUE (onglet "Email Templates")
NEXT_PUBLIC_EMAILJS_TEMPLATE_CONTACT=template_uprldgt

# Template de confirmation automatique envoye AU CLIENT
NEXT_PUBLIC_EMAILJS_TEMPLATE_AUTOREPLY=template_81igcv5

# La cle publique (onglet "Account" → "General" → "Public Key")
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=6Uqe4P41qEJPMvCa2
